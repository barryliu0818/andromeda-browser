target_os = "android"
target_cpu = "x64"
is_debug = false
is_component_build = false
# 不含除錯符號：編譯快、輸出小
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
# 播放 H.264／AAC（多數影片網站要用；個人自用）
proprietary_codecs = true
ffmpeg_branding = "Chrome"
treat_warnings_as_errors = false
chrome_public_manifest_package = "com.liquid.orea"
system_webview_package_name = "com.liquid.orea.webview"
