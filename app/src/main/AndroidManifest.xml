<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 填入密碼前的指紋／螢幕鎖驗證 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 17：存取區域網路（路由器、NAS 等）需使用者同意 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- 下載引擎：前景服務保活＋通知列進度 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 網頁要求定位、相機、麥克風（geolocation、getUserMedia、上傳時拍照）：先問網站再要系統權限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Android 9 以下沒有 MediaStore.Downloads，直接寫入公用「下載」資料夾 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 跳轉 App：要知道 taobao://、weixin:// 這類自訂協定有沒有 App 能開（協定無法逐一列在 queries 裡） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <!-- 起始頁語音搜尋 -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- 網頁上傳時拍照／錄影 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.provider.MediaStore.RECORD_SOUND" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <!-- 單一 Activity：uiMode 等變更不重建（onConfigurationChanged 更新配色），網頁與播放器狀態不中斷 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 預設瀏覽器（RoleManager.ROLE_BROWSER 需要這兩組） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity>

        <service
            android:name=".browser.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 下載完成後開啟檔案：DownloadEngine 用 "${packageName}.files" -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 換成 Orea 核心時，網頁渲染程序用的替身服務（WebViewUpgrade） -->
        <service android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService0" android:exported="false" android:process=":sandboxed_process0" />
        <service android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService1" android:exported="false" android:process=":sandboxed_process1" />
        <service android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService2" android:exported="false" android:process=":sandboxed_process2" />
        <service android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService3" android:exported="false" android:process=":sandboxed_process3" />
        <service android:name="com.norman.webviewup.lib.sandbox.stub.StubSandboxedProcessService4" android:exported="false" android:process=":sandboxed_process4" />

        <!-- Macrobenchmark 可量測 release 版 -->
        <profileable android:shell="true" />
    </application>
</manifest>
